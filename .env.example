# 每个 shared 填入独立有效的 CNKI Cookie。
CNKI_COOKIE_SHARED_1=
CNKI_COOKIE_SHARED_2=
CNKI_COOKIE_SHARED_3=
CNKI_COOKIE_SHARED_4=
CNKI_COOKIE_SHARED_5=
CNKI_COOKIE_SHARED_6=
CNKI_COOKIE_SHARED_7=
CNKI_COOKIE_SHARED_8=

# 可选兜底 Cookie：仅在对应 CNKI_COOKIE_SHARED_N 为空时使用。
CNKI_COOKIE=

# 可选 QQ 邮箱通知：使用发件邮箱的 SMTP 授权码，不是 QQ 登录密码。
# 仅在重载完整 Cookie 后搜索接口仍明确返回 401 时通知。
CNKI_ALERT_EMAIL_FROM=
CNKI_ALERT_EMAIL_AUTH_CODE=
CNKI_ALERT_EMAIL_TO=
